{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "$room.matches(/^[a-z]{5}$/)",
        ".write": "$room.matches(/^[a-z]{5}$/) && (!newData.exists() || newData.hasChildren(['schema','mode','createdAt','dayKey','hostId','gameState','scores','words','presence']))",
        "schema": { ".validate": "newData.isNumber() && newData.val() == 21" },
        "mode": { ".validate": "newData.isString() && newData.val().length <= 32" },
        "createdAt": { ".validate": "newData.isNumber() && newData.val() <= now + 10000" },
        "dayKey": { ".validate": "newData.isString() && newData.val().length == 8" },
        "hostId": { ".validate": "newData.isString() && newData.val().length <= 128" },
        "guestId": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 128)" }
      }
    },
    "meta": {
      "dailyRoomCodes": {
        "$day": {
          "$room": {
            ".read": "$day.matches(/^\\d{8}$/) && $room.matches(/^[a-z]{5}$/)",
            ".write": "$day.matches(/^\\d{8}$/) && $room.matches(/^[a-z]{5}$/) && (!newData.exists() || (newData.isString() && newData.val().length <= 180))"
          }
        }
      },
      "closedRoomCodes": {
        "$day": {
          "$room": {
            ".read": "$day.matches(/^\\d{8}$/) && $room.matches(/^[a-z]{5}$/)",
            ".write": "$day.matches(/^\\d{8}$/) && $room.matches(/^[a-z]{5}$/)"
          }
        }
      }
    },
    "matchmaking": {
      "random": {
        ".read": true,
        ".write": "newData.val() == null || newData.hasChild('waiting')"
      }
    }
  }
}
