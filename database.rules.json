{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$room": {
        ".read": "$room.matches(/^[a-z]{5}$/)",
        ".write": "$room.matches(/^[a-z]{5}$/) && (!newData.exists() || newData.hasChildren(['schema','mode','createdAt','dayKey','hostId','gameState','scores','presence']))",
        "schema": {
          ".validate": "newData.isNumber() && (newData.val() == 21 || newData.val() == 22)"
        },
        "mode": {
          ".validate": "newData.isString() && newData.val().length <= 32"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() <= now + 10000"
        },
        "dayKey": {
          ".validate": "newData.isString() && newData.val().length == 8"
        },
        "hostId": {
          ".validate": "newData.isString() && newData.val().length <= 128"
        },
        "guestId": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 128)"
        }
      }
    },
    "meta": {
      "dailyRoomCodes": {
        "$day": {
          "$room": {
            ".read": "$day.matches(/^\\d{8}$/) && $room.matches(/^[a-z]{5}$/)",
            ".write": "$day.matches(/^\\d{8}$/) && $room.matches(/^[a-z]{5}$/) && (!newData.exists() || (newData.isString() && newData.val().length <= 180))"
          }
        }
      },
      "closedRoomCodes": {
        "$day": {
          "$room": {
            ".read": "$day.matches(/^\\d{8}$/) && $room.matches(/^[a-z]{5}$/)",
            ".write": "$day.matches(/^\\d{8}$/) && $room.matches(/^[a-z]{5}$/)"
          }
        }
      },
      "nextMemberRoom": {
        ".read": "auth != null",
        ".write": "auth != null && newData.isNumber() && newData.val() >= 100000 && newData.val() <= 9999999 && (data.val() == null || newData.val() == data.val() + 1)"
      }
    },
    "matchmaking": {
      "random": {
        ".read": true,
        ".write": "newData.val() == null || newData.hasChild('waiting')"
      },
      "randomPool": {
        ".read": true,
        ".write": true,
        ".indexOn": [
          "enteredAt"
        ]
      }
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "memberRooms": {
      "$room": {
        ".read": "$room.matches(/^\\d{6,7}$/)",
        ".write": "auth != null && $room.matches(/^\\d{6,7}$/) && ((!data.exists() && newData.child('ownerUid').val() == auth.uid) || data.child('ownerUid').val() == auth.uid)"
      }
    }
  }
}
